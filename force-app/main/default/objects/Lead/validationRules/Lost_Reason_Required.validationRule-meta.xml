<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lost_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Closed Lost&quot;),
    ISBLANK(Lead_Lost_Reason__c)
)</errorConditionFormula>
    <errorDisplayField>Lead_Lost_Reason__c</errorDisplayField>
    <errorMessage>Please enter a Lost Reason before closing the Lead.</errorMessage>
</ValidationRule>
