<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>65.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>
        Project Configuration Image Gallery
    </masterLabel>

    <description>
        Displays images attached to Project Configuration records
        associated with the current Unit's Project.
    </description>

    <targets>

        <target>
            lightning__RecordPage
        </target>

    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__RecordPage">

            <objects>

                <object>
                    Unit__c
                </object>

            </objects>

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>